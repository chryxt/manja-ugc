# Required: Supabase/Postgres direct connection string for the same MANJA UGC database.
DATABASE_URL=postgresql://postgres:password@host:5432/postgres

# Required: BullMQ Redis endpoint (redis:// or rediss://).
REDIS_URL=rediss://default:password@host:6379

# Required: provider credentials. Keep server-side only.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Required: Cloudflare R2 private bucket credentials.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional override; default R2 endpoint is derived from account id.
R2_ENDPOINT=

# Provider/model routing.
PRODUCT_DNA_MODEL=gemini-3.5-flash-lite
UGC_SCRIPT_MODEL=gpt-5-mini
VEO_MODEL=veo-3.1-generate-preview
VEO_POLL_DELAY_SECONDS=20
ASSET_URL_TTL_SECONDS=900

# Runtime identity / queue controls.
WORKER_ID=
WORKER_QUEUE_NAME=ugc-jobs
WORKER_CONCURRENCY=1
WORKER_LEASE_TTL_SECONDS=90
WORKER_LOCK_DURATION_MS=120000
WORKER_STALLED_INTERVAL_MS=30000
WORKER_MAX_STALLED_COUNT=1
WORKER_DB_POOL_MAX=10

# Transactional outbox dispatcher.
OUTBOX_DISPATCH_INTERVAL_MS=2000
OUTBOX_DISPATCH_BATCH_SIZE=20
OUTBOX_DISPATCH_LEASE_SECONDS=60
OUTBOX_DISPATCH_RETRY_DELAY_SECONDS=5
OUTBOX_DISPATCH_MAX_ATTEMPTS=10

# Process lifecycle / health server.
HOST=0.0.0.0
PORT=8080
WORKER_SHUTDOWN_TIMEOUT_MS=30000
